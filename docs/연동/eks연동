[RBAC 관리자 권한(system:masters)을 얻는 설정(aws-auth 등록)]
kubectl get configmap aws-auth -n kube-system -o yaml > aws-auth.yaml
# 현재 클러스터의 권한 매핑정보를 aws-auth.yaml 파일로 저장











# terraform 설치
PS : Invoke-WebRequest -Uri "https://releases.hashicorp.com/terraform/1.9.7/terraform_1.9.7_windows_amd64.zip" -OutFile "$env:TEMP\terraform.zip"
PS : Expand-Archive -Path "$env:TEMP\terraform.zip" -DestinationPath "C:\terraform"

path 시스템 변수 >> C:\terraform 추가

# 버전 확인
terraform -version

# main.tf 를 terraform-azure-vm 디렉터리 안에 생성했기에 이동을 해서 테라폼 실행
cd terraform-azure-vm

# azure 연동
az login

# 테라폼 실행
terraform init
terraform plan
terraform apply
yes

# 테라폼 삭제(선택)
terraform destroy

# main.tf에 RSA Key 터미널에 설정코드가 있으니 직접 cmd에 RSA key 생성
 ssh-keygen -t rsa -b 4096

# CLI로 Bastion Native 터널링 활성화
az network bastion update `
  --name tf-bastion `
  --resource-group tf-rg-demo `
  --enable-tunneling true

# 정상출력결과 예시
true

# tf-vm1 접속과정
# tf-vm1의 리소스 ID를 실제로 확인해야함
az vm show -g tf-rg-demo -n tf-vm1 --query id -o tsv

# 위 명령어를 실행하면 아래와같이 출력이됨
/subscriptions/6692c162-4611-41d5-88d5-e8732f36579b/resourceGroups/tf-rg-demo/providers/Microsoft.Compute/virtualMachines/tf-vm1

# 리소스 ID를 아래와같이 추가를 해서 터널생성
az network bastion tunnel --name tf-bastion --resource-group tf-rg-demo --target-resource-id "여기에_전체_ID_붙여넣기" --resource-port 22 --port 50022

# 위 명령어 실행하면 아래와같이 출력이되면 터널이 정상작동
Opening tunnel on 127.0.0.1:50022 to target 22...
Opening tunnel on port: 50022 Tunnel is ready, connect on port 50022, Ctrl + C to close


# ssh 접속
# RSA 키의 패스워드 입력 후 엔터 누르면 ssh 접속 완료 현재 작성자의 RSA 키 패스워드는 a
ssh azureuser@127.0.0.1 -p 50022



